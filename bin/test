#!/usr/bin/env bash
set -Eeuo pipefail
IFS=$'\n\t'

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TEST_ROOT="${OPSFORGE_TEST_OUTPUT:-$ROOT/.ci-artifacts}"

usage() {
  cat <<'USAGE'
Usage:
  bin/test syntax
  bin/test help
  bin/test shellcheck
  bin/test forbidden-files
  bin/test wrapper-targets
  bin/test script-catalog
  bin/test output-contract
  bin/test linux-fixtures
  bin/test linux-feasibility
  bin/test runtime-linux
  bin/test readability
  bin/test installer
  bin/test security-regressions
  bin/test all

Runs local validation for opsforge. The tests are read-only against the host and
write their own evidence under .ci-artifacts/ unless OPSFORGE_TEST_OUTPUT is set.
USAGE
}

say() {
  printf '[test] %s\n' "$*"
}

fail() {
  printf '[test] ERROR: %s\n' "$*" >&2
  exit 1
}

make_run_dir() {
  local name="$1"
  local stamp dir
  stamp="$(date +%Y%m%d-%H%M%S)"
  mkdir -p "$TEST_ROOT"
  dir="$(mktemp -d "$TEST_ROOT/$name-$stamp.XXXXXX")"
  chmod 755 "$dir"
  printf '%s\n' "$dir"
}

assert_file() {
  local file="$1"
  [ -f "$file" ] || fail "expected file was not created: $file"
}

assert_dir() {
  local dir="$1"
  [ -d "$dir" ] || fail "expected directory was not created: $dir"
}

assert_nonempty_file() {
  local file="$1"
  assert_file "$file"
  [ -s "$file" ] || fail "expected file to be non-empty: $file"
}

assert_text() {
  local file="$1"
  local pattern="$2"
  grep -F "$pattern" "$file" >/dev/null 2>&1 || fail "expected '$pattern' in $file"
}

assert_bash_header() {
  local file="$1"
  local first second third
  first="$(sed -n '1p' "$file")"
  second="$(sed -n '2p' "$file")"
  third="$(sed -n '3p' "$file")"
  [ "$first" = '#!/usr/bin/env bash' ] || fail "bad bash shebang: $file"
  [ "$second" = 'set -Eeuo pipefail' ] || fail "missing bash safety flags on line 2: $file"
  [ "$third" = "IFS=\$'\\n\\t'" ] || fail "missing bash IFS on line 3: $file"
}

latest_output_dir() {
  local base="$1"
  local match="$2"
  find "$base" -mindepth 1 -maxdepth 1 -type d -name "*-$match-*" -printf '%T@ %p\n' |
    sort -n |
    awk 'BEGIN { path="" } { sub(/^[^ ]+ /, ""); path=$0 } END { print path }'
}

latest_profile_dir() {
  local base="$1"
  local profile="$2"
  find "$base" -mindepth 1 -maxdepth 1 -type d -name "opsforge-linux-$profile-*" -printf '%T@ %p\n' |
    sort -n |
    awk 'BEGIN { path="" } { sub(/^[^ ]+ /, ""); path=$0 } END { print path }'
}

assert_output_contract() {
  local out_dir="$1"
  "$ROOT/bin/validate-output-contract" "$out_dir" >/dev/null
}

assert_contracts_under() {
  local base="$1"
  local count=0
  while IFS= read -r findings; do
    assert_output_contract "$(dirname "$findings")"
    count=$((count + 1))
  done < <(find "$base" -mindepth 2 -maxdepth 2 -name findings.json | sort)
  [ "$count" -gt 0 ] || fail "no script output directories found under $base"
  say "validated output contracts=$count"
}

assert_init_marker() {
  local expected="${OPSFORGE_EXPECT_INIT:-}"
  local triage_dir services_file marker
  [ -n "$expected" ] || return 0
  triage_dir="$(latest_output_dir "$LINUX_FEASIBILITY_ROOT" linux-triage-collector)"
  [ -n "$triage_dir" ] || fail "triage output directory not found for init assertion"
  services_file="$triage_dir/raw/services.txt"
  assert_file "$services_file"

  case "$expected" in
    systemd) marker='systemd' ;;
    runit) marker='runit' ;;
    openrc) marker='openrc' ;;
    *) fail "unknown OPSFORGE_EXPECT_INIT value: $expected" ;;
  esac

  grep -Eiq -- "$marker" "$services_file" ||
    fail "expected $expected marker in triage services evidence: $services_file"
  say "init marker matched: $expected"
}

assert_doctor_limitations() {
  local expected="${OPSFORGE_EXPECT_INIT:-}"
  local doctor_file="$LINUX_FEASIBILITY_ROOT/doctor.txt"
  local skip_count

  [ "$expected" = "runit" ] || [ "$expected" = "openrc" ] || return 0

  OPSFORGE_DOCTOR_OUTPUT="$LINUX_FEASIBILITY_ROOT" \
    "$ROOT/bin/opsforge" doctor > "$doctor_file"
  skip_count="$(
    grep -Ec 'systemd checks are skipped on this host|systemd-only service evidence is skipped' \
      "$doctor_file" || true
  )"
  [ "$skip_count" -eq 1 ] ||
    fail "doctor reported duplicate systemd limitations for $expected"
}

run_runtime_linux_one() {
  local name="$1"
  local script_name="$2"
  shift 2
  say "runtime-linux: $name"
  "$@"
  local out_dir
  out_dir="$(latest_output_dir "$OPSFORGE_RUNTIME_OUTPUT_DIR" "$script_name")"
  [ -n "$out_dir" ] || fail "$name did not create an output directory"
  printf '[test] runtime-linux output: %s\n' "$out_dir"
  "$ROOT/bin/validate-output-contract" "$out_dir"
}

run_runtime_linux_profile() {
  local profile="$1"
  shift
  say "runtime-linux profile: $profile"
  "$@"
  local out_dir
  out_dir="$(latest_profile_dir "$OPSFORGE_RUNTIME_OUTPUT_DIR" "$profile")"
  [ -n "$out_dir" ] || fail "$profile profile did not create a parent output directory"
  printf '[test] runtime-linux profile output: %s\n' "$out_dir"
  assert_nonempty_file "$out_dir/run-summary.md"
  assert_nonempty_file "$out_dir/run-summary.json"
  assert_contracts_under "$out_dir"
}

test_syntax() {
  say "checking bash syntax"
  while IFS= read -r file; do
    case "$file" in
      "$ROOT/bin/"*|"$ROOT/scripts/linux/"*|"$ROOT/install.sh") assert_bash_header "$file" ;;
    esac
    bash -n "$file"
  done < <(
    {
      find "$ROOT/bin" "$ROOT/lib" "$ROOT/scripts" -type f \( \
        -name '*.sh' -o -name opsforge -o -name test -o -name validate-output-contract \
      \)
      printf '%s\n' "$ROOT/install.sh"
    } | sort
  )
}

test_help() {
  say "checking linux script help output"
  while IFS= read -r file; do
    "$file" --help >/dev/null
  done < <(find "$ROOT/scripts/linux" -type f -name '*.sh' | sort)
  "$ROOT/bin/opsforge" --help >/dev/null
  "$ROOT/bin/test" --help >/dev/null
  "$ROOT/bin/validate-output-contract" --help >/dev/null
  "$ROOT/install.sh" --help >/dev/null
  "$ROOT/bin/opsforge" >/dev/null 2>&1 && fail "opsforge without arguments should exit non-zero"
  [ "$?" -eq 2 ] || fail "opsforge without arguments should exit 2"
}

test_shellcheck() {
  if ! command -v shellcheck >/dev/null 2>&1; then
    say "shellcheck not installed; skipping"
    return 0
  fi
  say "running shellcheck"
  mapfile -t files < <(find "$ROOT/bin" "$ROOT/lib" "$ROOT/scripts/linux" -type f \( -name '*.sh' -o -name opsforge -o -name test \) | sort)
  shellcheck -S error "${files[@]}"
}

test_forbidden_files() {
  say "checking forbidden core language files"
  local files
  files="$(find "$ROOT" \
    -path "$ROOT/.git" -prune -o \
    -path "$ROOT/.ci-artifacts" -prune -o \
    -path "$ROOT/output" -prune -o \
    -type f \( \
      -name '*.py' -o -name '*.go' -o -name '*.rs' -o -name '*.js' -o \
      -name '*.ts' -o -name '*.rb' -o -name '*.pl' -o -name '*.exe' -o \
      -name '*.dll' -o -name '*.so' -o -name '*.dylib' \
    \) -print)"
  [ -z "$files" ] || fail "forbidden core language or binary files found: $files"
}

test_readability() {
  say "checking source readability"
  local failed=0
  while IFS= read -r file; do
    if [ -f "$file" ] && grep -Iq . "$file"; then
      awk 'length($0) > 500 {printf "%s:%d: line length %d\n", FILENAME, NR, length($0); bad=1} END {exit bad ? 1 : 0}' "$file" ||
        failed=1
    fi
  done < <(
    find "$ROOT" \
      -path "$ROOT/.git" -prune -o \
      -path "$ROOT/.ci-artifacts" -prune -o \
      -path "$ROOT/output" -prune -o \
      -path "$ROOT/examples" -prune -o \
      -type f \( \
        -name '*.md' -o -name '*.sh' -o -name '*.ps1' -o -name '*.yml' -o \
        -name '*.yaml' -o -name '*.conf' -o -name '.gitignore' -o \
        -path "$ROOT/bin/opsforge" -o -path "$ROOT/bin/test" -o \
        -path "$ROOT/bin/validate-output-contract" \
      \) -print | sort
  )
  [ "$failed" -eq 0 ] || fail "readability check failed"
}

test_wrapper_targets() {
  say "checking wrapper target paths"
  local target pattern
  while IFS= read -r target; do
    [ -f "$ROOT/$target" ] || fail "Bash wrapper references missing script: $target"
  done < <(sed -n 's/.*exec "$ROOT\/\([^"]*\)".*/\1/p' "$ROOT/bin/opsforge" | sort)

  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    grep -F "$pattern" "$ROOT/bin/opsforge" >/dev/null 2>&1 ||
      fail "Bash wrapper is missing dispatch flow: $pattern"
  done <<'EOF'
linux:doctor) run_doctor "$@" ;;
linux:quick|linux:ir|linux:noc|linux:full|linux:all) run_linux_profile "$command_name" "$@" ;;
linux:triage) exec "$ROOT/scripts/linux/endpoint/linux-triage-collector.sh" "$@" ;;
linux:persistence) exec "$ROOT/scripts/linux/persistence/linux-persistence-hunter.sh" "$@" ;;
linux:deleted-binaries|linux:deleted-binary) exec "$ROOT/scripts/linux/forensic/deleted-binary-detector.sh" "$@" ;;
linux:disk-rca) exec "$ROOT/scripts/linux/noc/disk-pressure-rca.sh" "$@" ;;
linux:tls) exec "$ROOT/scripts/linux/network/tls-inventory-scanner.sh" "$@" ;;
EOF

  while IFS= read -r target; do
    target="${target//\\//}"
    [ -f "$ROOT/$target" ] || fail "PowerShell wrapper references missing script: $target"
  done < <(
    sed -n 's/.*Join-Path \$Root '"'"'\(scripts[^'"'"']*\.ps1\)'"'"'.*/\1/p' "$ROOT/bin/opsforge.ps1" |
      sort
  )

  while IFS= read -r pattern; do
    [ -n "$pattern" ] || continue
    grep -F "$pattern" "$ROOT/bin/opsforge.ps1" >/dev/null 2>&1 ||
      fail "PowerShell wrapper is missing dispatch flow: $pattern"
  done <<'EOF'
'windows:doctor' { Invoke-OpsForgeDoctor; break }
'windows:quick' { Invoke-WindowsProfile -Profile 'quick'; break }
'windows:ir' { Invoke-WindowsProfile -Profile 'ir'; break }
'windows:full' { Invoke-WindowsProfile -Profile 'full'; break }
'windows:all' { Invoke-WindowsAll; break }
'windows:triage' { Invoke-OpsForgeScript (Join-Path $Root 'scripts\windows\endpoint\Invoke-WinTriage.ps1'); break }
'windows:persistence' { Invoke-OpsForgeScript (Join-Path $Root 'scripts\windows\persistence\Find-WinPersistence.ps1'); break }
'windows:tasks' { Invoke-OpsForgeScript (Join-Path $Root 'scripts\windows\persistence\Test-WinScheduledTasks.ps1'); break }
'windows:network' { Invoke-OpsForgeScript (Join-Path $Root 'scripts\windows\network\Get-WinNetworkExposure.ps1'); break }
'windows:timeline' { Invoke-OpsForgeScript (Join-Path $Root 'scripts\windows\forensic\New-WinEventTimeline.ps1'); break }
EOF
}

test_script_catalog() {
  say "checking script catalog consistency"
  local script documented
  while IFS= read -r script; do
    documented="$(grep -F "\`$script\`" "$ROOT/docs/script-catalog.md" || true)"
    [ -n "$documented" ] || fail "script is missing from docs/script-catalog.md: $script"
  done < <(cd "$ROOT" && find scripts -type f \( -name '*.sh' -o -name '*.ps1' \) | sort)

  while IFS= read -r script; do
    [ -f "$ROOT/$script" ] || fail "docs/script-catalog.md references missing script: $script"
  done < <(grep -o '`scripts/[^`]*`' "$ROOT/docs/script-catalog.md" | tr -d '`' | sort -u)
}

test_output_contract() {
  say "checking output contract fixture"
  "$ROOT/bin/validate-output-contract" "$ROOT/tests/fixtures/output-contract-valid" >/dev/null
  local run_dir invalid shell_tools tool
  run_dir="$(make_run_dir output-contract)"
  shell_tools="$run_dir/shell-tools"
  mkdir -p "$shell_tools"
  for tool in bash tr grep awk wc cmp; do
    ln -s "$(command -v "$tool")" "$shell_tools/$tool"
  done
  invalid="$run_dir/invalid"
  cp -R "$ROOT/tests/fixtures/output-contract-valid" "$invalid"
  printf '[not json]\n' > "$invalid/findings.json"
  cp "$invalid/findings.json" "$invalid/normalized/findings.json"
  if "$ROOT/bin/validate-output-contract" "$invalid" >/dev/null 2>&1; then
    fail "output validator accepted invalid JSON"
  fi
  if PATH="$shell_tools" "$ROOT/bin/validate-output-contract" "$invalid" >/dev/null 2>&1; then
    fail "shell-only output validator accepted invalid JSON"
  fi
  PATH="$shell_tools" "$ROOT/bin/validate-output-contract" "$ROOT/tests/fixtures/output-contract-valid" >/dev/null
  cp -R "$ROOT/tests/fixtures/output-contract-valid" "$run_dir/wrong-types"
  sed -i 's/"id":"FIXTURE-001"/"id":1/' "$run_dir/wrong-types/findings.json"
  cp "$run_dir/wrong-types/findings.json" "$run_dir/wrong-types/normalized/findings.json"
  if "$ROOT/bin/validate-output-contract" "$run_dir/wrong-types" >/dev/null 2>&1; then
    fail "output validator accepted wrong field types"
  fi
  if PATH="$shell_tools" "$ROOT/bin/validate-output-contract" "$run_dir/wrong-types" >/dev/null 2>&1; then
    fail "shell-only output validator accepted wrong field types"
  fi
  cp -R "$ROOT/tests/fixtures/output-contract-valid" "$run_dir/bad-escape"
  sed -i 's/FIXTURE-001/FIXTURE-\\q/' "$run_dir/bad-escape/findings.json"
  cp "$run_dir/bad-escape/findings.json" "$run_dir/bad-escape/normalized/findings.json"
  if PATH="$shell_tools" "$ROOT/bin/validate-output-contract" "$run_dir/bad-escape" >/dev/null 2>&1; then
    fail "shell-only output validator accepted an invalid JSON escape"
  fi
  local escaped
  escaped="$(source "$ROOT/lib/common.sh"; json_escape $'a\001b')"
  [ "$escaped" = 'a\u0001b' ] || fail "json escaping left a control character unescaped"
}

test_installer() {
  say "checking installer"
  local run_dir prefix app_dir bin_dir
  run_dir="$(make_run_dir installer)"
  prefix="$run_dir/usr"
  app_dir="$run_dir/opt/opsforge"
  bin_dir="$prefix/bin"

  "$ROOT/install.sh" \
    --source "$ROOT" \
    --prefix "$prefix" \
    --app-dir "$app_dir" \
    --bin-dir "$bin_dir" \
    --dry-run >/dev/null

  [ ! -e "$app_dir" ] || fail "installer dry-run created app dir"
  [ ! -e "$bin_dir/opsforge" ] || fail "installer dry-run created shim"

  "$ROOT/install.sh" \
    --source "$ROOT" \
    --prefix "$prefix" \
    --app-dir "$app_dir" \
    --bin-dir "$bin_dir" \
    --check >/dev/null

  "$ROOT/install.sh" \
    --source "$ROOT" \
    --prefix "$prefix" \
    --app-dir "$app_dir" \
    --bin-dir "$bin_dir" \
    --force >/dev/null

  assert_file "$app_dir/bin/opsforge"
  assert_file "$bin_dir/opsforge"
  "$bin_dir/opsforge" --help >/dev/null
  OPSFORGE_DOCTOR_OUTPUT="$run_dir/output" "$bin_dir/opsforge" doctor >/dev/null

  local collision_target collision_bin
  collision_target="$run_dir/launcher-target"
  collision_bin="$run_dir/collision-bin"
  printf 'keep\n' > "$collision_target"
  mkdir -p "$collision_bin"
  ln -s "$collision_target" "$collision_bin/opsforge"
  if "$ROOT/install.sh" --source "$ROOT" --app-dir "$run_dir/opsforge-collision" --bin-dir "$collision_bin" >/dev/null 2>&1; then
    fail "installer replaced an existing launcher without --force"
  fi
  [ "$(cat "$collision_target")" = 'keep' ] || fail "installer followed launcher symlink"
  "$ROOT/install.sh" --source "$ROOT" --app-dir "$run_dir/opsforge-collision" --bin-dir "$collision_bin" --force >/dev/null
  [ ! -L "$collision_bin/opsforge" ] || fail "installer did not replace launcher symlink"
  [ "$(cat "$collision_target")" = 'keep' ] || fail "forced installer changed launcher symlink target"
}

test_security_regressions() {
  say "checking security regressions"
  local run_dir output_base out_dir fixture_root baseline changed_dir fake_bin ssh_dir
  run_dir="$(make_run_dir security-regressions)"
  output_base="$run_dir/output with spaces"
  "$ROOT/bin/opsforge" linux persistence --output "$output_base" --quiet
  out_dir="$(latest_output_dir "$output_base" linux-persistence-hunter)"
  [ -n "$out_dir" ] || fail "space-containing output path was not discovered"
  assert_file "$out_dir/evidence.tar.gz"
  [ "$(stat -c '%a' "$out_dir")" = 700 ] || fail "output directory is not private"
  [ "$(stat -c '%a' "$out_dir/findings.json")" = 600 ] || fail "output file is not private"
  mkdir -p "$run_dir/redirected-output"
  ln -s "$run_dir/redirected-output" "$run_dir/output-link"
  if "$ROOT/bin/opsforge" linux persistence --output "$run_dir/output-link" --quiet >/dev/null 2>&1; then
    fail "collector followed a symlink output base"
  fi
  if "$ROOT/bin/opsforge" linux quick --output "$run_dir/output-link" --quiet >/dev/null 2>&1; then
    fail "profile followed a symlink output base"
  fi
  [ -z "$(find "$run_dir/redirected-output" -mindepth 1 -print -quit)" ] || fail "symlink target received output"
  "$ROOT/bin/opsforge" linux quick --output "$output_base" --quiet
  out_dir="$(latest_profile_dir "$output_base" quick)"
  assert_nonempty_file "$out_dir/run-summary.json"
  (
    cd "$run_dir"
    "$ROOT/bin/opsforge" linux persistence --output relative-output --quiet
  )
  out_dir="$(latest_output_dir "$run_dir/relative-output" linux-persistence-hunter)"
  assert_file "$out_dir/evidence.tar.gz"

  ssh_dir="$run_dir/ssh"
  mkdir -p "$ssh_dir/conf.d"
  ssh-keygen -q -N '' -t ed25519 -f "$ssh_dir/hostkey"
  printf 'PasswordAuthentication yes\n' > "$ssh_dir/conf.d/hardening.conf"
  printf 'HostKey %s/hostkey\nInclude %s/conf.d/*.conf\nPasswordAuthentication no\nMatch User test\nPasswordAuthentication no\n' "$ssh_dir" "$ssh_dir" > "$ssh_dir/sshd_config"
  "$ROOT/scripts/linux/hardening/ssh-hardening-audit.sh" --config "$ssh_dir/sshd_config" --output "$run_dir" --quiet
  out_dir="$(latest_output_dir "$run_dir" ssh-hardening-audit)"
  assert_text "$out_dir/findings.json" 'LINUX-SSH-PasswordAuthentication'
  assert_text "$out_dir/report.md" 'Match blocks are evaluated only'
  if grep -F 'LINUX-SSH-WEAK-CRYPTO' "$out_dir/findings.json" >/dev/null; then
    fail "default SSH algorithms were reported as weak"
  fi

  fixture_root="$run_dir/privileged"
  mkdir -p "$fixture_root"
  cp /bin/true "$fixture_root/tool"
  chmod 4755 "$fixture_root/tool"
  baseline="$run_dir/suid-baseline.tsv"
  OPSFORGE_SUID_SCAN_ROOT="$fixture_root" "$ROOT/scripts/linux/hardening/suid-drift-monitor.sh" --baseline --baseline-file "$baseline" --output "$run_dir" --quiet
  cp /bin/false "$fixture_root/tool"
  chmod 4755 "$fixture_root/tool"
  OPSFORGE_SUID_SCAN_ROOT="$fixture_root" "$ROOT/scripts/linux/hardening/suid-drift-monitor.sh" --check --baseline-file "$baseline" --output "$run_dir" --quiet
  changed_dir="$(latest_output_dir "$run_dir" suid-drift-monitor)"
  assert_text "$changed_dir/findings.json" 'LINUX-SUID-CHANGED'
  if grep -F 'LINUX-SUID-WW-' "$changed_dir/findings.json" >/dev/null; then
    fail "ordinary 4755 file was reported as world-writable"
  fi
  chmod 4775 "$fixture_root/tool"
  OPSFORGE_SUID_SCAN_ROOT="$fixture_root" "$ROOT/scripts/linux/hardening/suid-drift-monitor.sh" --check --baseline-file "$baseline" --output "$run_dir" --quiet
  changed_dir="$(latest_output_dir "$run_dir" suid-drift-monitor)"
  if grep -F 'LINUX-SUID-WW-' "$changed_dir/findings.json" >/dev/null; then
    fail "group-writable 4775 file was reported as world-writable"
  fi
  chmod 4777 "$fixture_root/tool"
  OPSFORGE_SUID_SCAN_ROOT="$fixture_root" "$ROOT/scripts/linux/hardening/suid-drift-monitor.sh" --check --baseline-file "$baseline" --output "$run_dir" --quiet
  changed_dir="$(latest_output_dir "$run_dir" suid-drift-monitor)"
  assert_text "$changed_dir/findings.json" 'LINUX-SUID-WW-'

  fake_bin="$run_dir/fake-bin"
  mkdir -p "$fake_bin"
  printf '#!/usr/bin/env bash\nprintf "table inet filter { chain input { tcp dport 22 drop } }\\n"\n' > "$fake_bin/nft"
  chmod 755 "$fake_bin/nft"
  PATH="$fake_bin:$PATH" "$ROOT/scripts/linux/network/firewall-rule-analyzer.sh" --output "$run_dir" --quiet
  out_dir="$(latest_output_dir "$run_dir" firewall-rule-analyzer)"
  if grep -F 'LINUX-FW-ADMIN-PORTS' "$out_dir/findings.json" >/dev/null; then
    fail "drop rule was reported as an allowed administrative port"
  fi
  printf '#!/usr/bin/env bash\nprintf "table inet filter { chain input { tcp dport 22 accept } }\\n"\n' > "$fake_bin/nft"
  PATH="$fake_bin:$PATH" "$ROOT/scripts/linux/network/firewall-rule-analyzer.sh" --output "$run_dir" --quiet
  out_dir="$(latest_output_dir "$run_dir" firewall-rule-analyzer)"
  assert_text "$out_dir/findings.json" 'LINUX-FW-ADMIN-PORTS'
  assert_text "$out_dir/normalized/collection-status.tsv" 'unavailable'
  assert_text "$out_dir/report.md" '## Collection Status'
  printf '#!/usr/bin/env bash\nprintf "table inet filter { chain input { tcp dport 22 drop } }\\n"\n' > "$fake_bin/nft"
  printf '#!/usr/bin/env bash\nprintf "22/tcp ALLOW IN Anywhere\\n"\n' > "$fake_bin/ufw"
  chmod 755 "$fake_bin/ufw"
  PATH="$fake_bin:$PATH" "$ROOT/scripts/linux/network/firewall-rule-analyzer.sh" --output "$run_dir" --quiet
  out_dir="$(latest_output_dir "$run_dir" firewall-rule-analyzer)"
  assert_text "$out_dir/findings.json" 'LINUX-FW-OPEN-ADMIN'
  printf '#!/usr/bin/env bash\nprintf "unavailable\\n"\n' > "$fake_bin/ufw"
  printf '#!/usr/bin/env bash\nprintf "services: ssh\\n"\n' > "$fake_bin/firewall-cmd"
  chmod 755 "$fake_bin/firewall-cmd"
  PATH="$fake_bin:$PATH" "$ROOT/scripts/linux/network/firewall-rule-analyzer.sh" --output "$run_dir" --quiet
  out_dir="$(latest_output_dir "$run_dir" firewall-rule-analyzer)"
  assert_text "$out_dir/findings.json" 'LINUX-FW-ADMIN-PORTS'
}

test_linux_fixtures() {
  say "running linux fixture tests"
  local run_dir fixture_dir home_dir log_file persistence_dir net_cfg tls_cfg silence_cfg
  run_dir="$(make_run_dir linux-fixtures)"
  fixture_dir="$ROOT/tests/fixtures/linux"
  home_dir="$run_dir/home"
  cp -R "$fixture_dir/home" "$home_dir"
  mkdir -p "$home_dir/.ssh" "$run_dir/logs"
  cp "$fixture_dir/logs/app.fixture" "$run_dir/logs/app.log"

  HOME="$home_dir" "$ROOT/bin/opsforge" linux persistence --output "$run_dir" --quiet
  persistence_dir="$(latest_output_dir "$run_dir" linux-persistence-hunter)"
  [ -n "$persistence_dir" ] || fail "persistence hunter did not create an output directory"
  assert_file "$persistence_dir/findings.json"
  assert_text "$persistence_dir/findings.json" "LINUX-PERSISTENCE"
  assert_text "$persistence_dir/report.md" "Suspicious Matches"
  assert_output_contract "$persistence_dir"

  log_file="$run_dir/logs/app.log"
  silence_cfg="$run_dir/log-sources.conf"
  printf 'fixture-app|%s|critical|1440\n' "$log_file" > "$silence_cfg"
  "$ROOT/bin/opsforge" linux log-silence --config "$silence_cfg" --output "$run_dir" --quiet
  assert_output_contract "$(latest_output_dir "$run_dir" log-source-silence-detector)"

  net_cfg="$run_dir/network-targets.conf"
  cp "$fixture_dir/network-targets.conf" "$net_cfg"
  "$ROOT/bin/opsforge" linux net-drift --targets "$net_cfg" --output "$run_dir" --quiet
  assert_text "$(latest_output_dir "$run_dir" network-path-drift)/findings.json" "LINUX-NETPATH-TCP"
  assert_output_contract "$(latest_output_dir "$run_dir" network-path-drift)"

  tls_cfg="$run_dir/tls-targets.conf"
  cp "$fixture_dir/tls-targets.conf" "$tls_cfg"
  "$ROOT/bin/opsforge" linux tls --targets "$tls_cfg" --output "$run_dir" --quiet
  assert_text "$(latest_output_dir "$run_dir" tls-inventory-scanner)/findings.json" "TLS-"
  assert_output_contract "$(latest_output_dir "$run_dir" tls-inventory-scanner)"

  say "fixture evidence: $run_dir"
}

run_one() {
  local name="$1"
  shift
  echo "::group::$name"
  local log="$LINUX_FEASIBILITY_ROOT/$name.log"
  if ! timeout 180 "$@" >"$log" 2>&1; then
    echo "::endgroup::"
    printf '::error::%s failed\n' "$name"
    cat "$log"
    return 1
  fi
  cat "$log"
  echo "::endgroup::"
}

test_linux_feasibility() {
  say "running linux feasibility suite"
  local cfg summaries
  LINUX_FEASIBILITY_ROOT="$(make_run_dir linux-feasibility)"
  export LINUX_FEASIBILITY_ROOT
  cfg="$LINUX_FEASIBILITY_ROOT/config"
  mkdir -p "$cfg"
  printf 'localhost|127.0.0.1|1\n' > "$cfg/network-targets.conf"
  printf 'localhost|127.0.0.1|1\n' > "$cfg/tls-targets.conf"
  printf 'tmp-log|%s/test.log|critical|1440\n' "$cfg" > "$cfg/log-sources.conf"
  printf 'test\n' > "$cfg/test.log"

  assert_doctor_limitations
  run_one triage "$ROOT/bin/opsforge" linux triage --output "$LINUX_FEASIBILITY_ROOT"
  assert_init_marker
  run_one persistence "$ROOT/bin/opsforge" linux persistence --output "$LINUX_FEASIBILITY_ROOT"
  run_one deleted "$ROOT/bin/opsforge" linux deleted-binaries --output "$LINUX_FEASIBILITY_ROOT"
  run_one proc-tree "$ROOT/bin/opsforge" linux proc-tree --output "$LINUX_FEASIBILITY_ROOT"
  run_one suid-baseline "$ROOT/bin/opsforge" linux suid --baseline --baseline-file "$cfg/suid-baseline.txt" --output "$LINUX_FEASIBILITY_ROOT"
  run_one suid-check "$ROOT/bin/opsforge" linux suid --check --baseline-file "$cfg/suid-baseline.txt" --output "$LINUX_FEASIBILITY_ROOT"
  run_one priv-surface "$ROOT/bin/opsforge" linux priv-surface --output "$LINUX_FEASIBILITY_ROOT"
  run_one ssh-audit "$ROOT/bin/opsforge" linux ssh-audit --output "$LINUX_FEASIBILITY_ROOT"
  run_one config-baseline "$ROOT/bin/opsforge" linux config-drift --baseline --baseline-dir "$cfg/config-baseline" --output "$LINUX_FEASIBILITY_ROOT"
  run_one config-check "$ROOT/bin/opsforge" linux config-drift --check --baseline-dir "$cfg/config-baseline" --output "$LINUX_FEASIBILITY_ROOT"
  run_one net-drift "$ROOT/bin/opsforge" linux net-drift --targets "$cfg/network-targets.conf" --output "$LINUX_FEASIBILITY_ROOT"
  run_one tls "$ROOT/bin/opsforge" linux tls --targets "$cfg/tls-targets.conf" --output "$LINUX_FEASIBILITY_ROOT"
  run_one firewall "$ROOT/bin/opsforge" linux firewall --output "$LINUX_FEASIBILITY_ROOT"
  run_one disk-rca "$ROOT/bin/opsforge" linux disk-rca --output "$LINUX_FEASIBILITY_ROOT"
  run_one log-silence "$ROOT/bin/opsforge" linux log-silence --config "$cfg/log-sources.conf" --output "$LINUX_FEASIBILITY_ROOT"
  run_one timeline "$ROOT/bin/opsforge" linux timeline --since-hours 1 --output "$LINUX_FEASIBILITY_ROOT"
  run_one web-triage "$ROOT/bin/opsforge" linux web-triage --output "$LINUX_FEASIBILITY_ROOT"

  summaries="$(find "$LINUX_FEASIBILITY_ROOT" -maxdepth 2 -name summary.txt | wc -l)"
  [ "$summaries" -ge 16 ] || fail "expected at least 16 summary files, got $summaries"
  assert_contracts_under "$LINUX_FEASIBILITY_ROOT"
  say "linux feasibility summaries=$summaries"
  say "linux feasibility evidence: $LINUX_FEASIBILITY_ROOT"
}

test_runtime_linux() {
  say "running Linux runtime validation"
  OPSFORGE_RUNTIME_OUTPUT_DIR="${OPSFORGE_RUNTIME_OUTPUT:-$ROOT/output}"
  if ! mkdir -p "$OPSFORGE_RUNTIME_OUTPUT_DIR" 2>/dev/null ||
    [ ! -w "$OPSFORGE_RUNTIME_OUTPUT_DIR" ]; then
    if [ -n "${OPSFORGE_RUNTIME_OUTPUT:-}" ]; then
      fail "runtime output directory is not writable: $OPSFORGE_RUNTIME_OUTPUT_DIR"
    fi
    OPSFORGE_RUNTIME_OUTPUT_DIR="$TEST_ROOT/runtime-output"
    say "output/ is not writable; using $OPSFORGE_RUNTIME_OUTPUT_DIR"
  fi
  export OPSFORGE_RUNTIME_OUTPUT_DIR
  mkdir -p "$OPSFORGE_RUNTIME_OUTPUT_DIR"

  "$ROOT/bin/opsforge" doctor >/dev/null

  run_runtime_linux_one \
    triage \
    linux-triage-collector \
    "$ROOT/bin/opsforge" linux triage \
    --output "$OPSFORGE_RUNTIME_OUTPUT_DIR" --markdown --json

  run_runtime_linux_one \
    persistence \
    linux-persistence-hunter \
    "$ROOT/bin/opsforge" linux persistence \
    --output "$OPSFORGE_RUNTIME_OUTPUT_DIR" --markdown --json

  run_runtime_linux_one \
    deleted-binaries \
    deleted-binary-detector \
    "$ROOT/bin/opsforge" linux deleted-binaries \
    --output "$OPSFORGE_RUNTIME_OUTPUT_DIR" --markdown --json

  run_runtime_linux_one \
    disk-rca \
    disk-pressure-rca \
    "$ROOT/bin/opsforge" linux disk-rca \
    --output "$OPSFORGE_RUNTIME_OUTPUT_DIR" --markdown --json

  if [ -f "$ROOT/configs/linux/tls-targets.conf" ]; then
    run_runtime_linux_one \
      tls \
      tls-inventory-scanner \
      "$ROOT/bin/opsforge" linux tls \
      --targets "$ROOT/configs/linux/tls-targets.conf" \
      --output "$OPSFORGE_RUNTIME_OUTPUT_DIR" --markdown --json
  fi

  run_runtime_linux_profile \
    quick \
    "$ROOT/bin/opsforge" linux quick \
    --output "$OPSFORGE_RUNTIME_OUTPUT_DIR" --markdown --json

  run_runtime_linux_profile \
    ir \
    "$ROOT/bin/opsforge" linux ir \
    --output "$OPSFORGE_RUNTIME_OUTPUT_DIR" --markdown --json

  run_runtime_linux_profile \
    noc \
    "$ROOT/bin/opsforge" linux noc \
    --output "$OPSFORGE_RUNTIME_OUTPUT_DIR" --markdown --json
}

case "${1:-}" in
  syntax) test_syntax ;;
  help) test_help ;;
  shellcheck) test_shellcheck ;;
  forbidden-files) test_forbidden_files ;;
  readability) test_readability ;;
  wrapper-targets) test_wrapper_targets ;;
  script-catalog) test_script_catalog ;;
  output-contract) test_output_contract ;;
  installer) test_installer ;;
  security-regressions) test_security_regressions ;;
  linux-fixtures) test_linux_fixtures ;;
  linux-feasibility) test_linux_feasibility ;;
  runtime-linux) test_runtime_linux ;;
  all)
    test_syntax
    test_help
    test_shellcheck
    test_forbidden_files
    test_readability
    test_wrapper_targets
    test_script_catalog
    test_output_contract
    test_installer
    test_security_regressions
    test_linux_fixtures
    test_linux_feasibility
    test_runtime_linux
    ;;
  -h|--help) usage ;;
  *) usage; exit 2 ;;
esac
